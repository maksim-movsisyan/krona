if(TEST_CASE STREQUAL "pure_neumann")
    set(expected "pure Neumann problem needs an explicit reference")
elseif(TEST_CASE STREQUAL "negative_diffusion")
    set(expected "face diffusivity must be finite and positive")
elseif(TEST_CASE STREQUAL "bad_source")
    set(expected "source density must be finite")
elseif(TEST_CASE STREQUAL "negative_boundary")
    set(expected "boundary flux relation must be finite with a nonnegative owner coefficient")
elseif(TEST_CASE STREQUAL "source_extent")
    set(expected "field/coefficient/source extent or storage is invalid")
elseif(TEST_CASE STREQUAL "pending")
    set(expected "assembly is pending")
elseif(TEST_CASE STREQUAL "nonorthogonal")
    set(expected "invalid or nonorthogonal face geometry")
else()
    message(FATAL_ERROR "Unknown expected failure: ${TEST_CASE}")
endif()
execute_process(COMMAND "${MPIEXEC_EXECUTABLE}" "${MPIEXEC_NUMPROC_FLAG}" 2
    ${MPIEXEC_PREFLAGS} "${TEST_EXECUTABLE}" ${MPIEXEC_POSTFLAGS} "${TEST_CASE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 100)
if(NOT "${status}" MATCHES "^[0-9]+$" OR status EQUAL 0)
    message(FATAL_ERROR "Expected an explicit failure, got ${status}\n${output}\n${error}")
endif()
string(FIND "${output}\n${error}" "${expected}" found)
if(found EQUAL -1)
    message(FATAL_ERROR "Failure did not report '${expected}'\n${output}\n${error}")
endif()
